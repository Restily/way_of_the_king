# Скопировать в .env и заполнить актуальными значениями
# .env НЕ коммитится в git!

# === Application ===
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# === Database ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wotk
POSTGRES_USER=wotk
POSTGRES_PASSWORD=wotk_dev
DATABASE_URL=postgresql+asyncpg://wotk:wotk_dev@postgres:5432/wotk

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Telegram ===
TELEGRAM_BOT_TOKEN=replace_me_with_botfather_token
TELEGRAM_BOT_USERNAME=WayOfTheKingDevBot
TELEGRAM_INITDATA_TTL_SECONDS=86400

# === JWT ===
JWT_SECRET=change_me_to_long_random_string_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000
JWT_WS_TOKEN_TTL_SECONDS=30

# === Internal HMAC (Colyseus → FastAPI) ===
INTERNAL_HMAC_SECRET=change_me_to_long_random_string_min_32_chars

# === TON (testnet для разработки!) ===
TON_NETWORK=testnet
TON_RPC_URL=https://testnet.toncenter.com/api/v2/jsonRPC
TON_RPC_API_KEY=
WOTK_JETTON_MASTER_ADDRESS=
HOT_WALLET_MNEMONIC=replace_with_24_words_or_use_env_secret_manager

# === Sentry ===
SENTRY_DSN=

# === Geo blocking ===
GEO_BLOCK_COUNTRIES=US,GB,IR,KP,SY,CU
