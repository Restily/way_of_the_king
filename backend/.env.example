# Скопировать в .env и заполнить актуальными значениями.
# .env НЕ коммитится в git!
#
# В staging/production приложение откажется стартовать если найдены
# небезопасные значения (см. backend/src/wotk/core/config.py validator).

# === Application ===
APP_ENV=development
# В проде ОБЯЗАТЕЛЬНО false. Включение в staging/production вызовет startup error.
APP_DEBUG=true
LOG_LEVEL=INFO

# === Database ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wotk
POSTGRES_USER=wotk
POSTGRES_PASSWORD=wotk_dev
DATABASE_URL=postgresql+asyncpg://wotk:wotk_dev@postgres:5432/wotk

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Telegram ===
# Получить через BotFather. ОБЯЗАТЕЛЕН для staging/production.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=WayOfTheKingDevBot
TELEGRAM_INITDATA_TTL_SECONDS=86400
# Прямой HTTPS URL Mini App (cloudflared/ngrok в dev, прод-домен в prod).
# Telegram WebAppInfo НЕ принимает t.me-ссылки — нужен реальный hosting.
# Если пусто — кнопка станет URL-кнопкой на t.me/<bot>/<short_name>.
TELEGRAM_MINIAPP_URL=
TELEGRAM_MINIAPP_SHORT_NAME=play

# === JWT ===
# ОБЯЗАТЕЛЕН для staging/production. Минимум 32 байта, не содержит "change_me"/"dev"/"example".
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000
JWT_WS_TOKEN_TTL_SECONDS=30

# === Internal HMAC ===
# Раздельные секреты для двух направлений Colyseus↔FastAPI (defense in depth).
# ОБА обязательны для staging/production, должны быть РАЗНЫМИ, ≥ 32 байта.
# Сгенерировать каждый: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_HMAC_REALTIME_TO_API=
INTERNAL_HMAC_API_TO_REALTIME=

# === TON ===
# В production ОБЯЗАТЕЛЬНО переключить на mainnet
TON_NETWORK=testnet
TON_RPC_URL=https://testnet.toncenter.com/api/v2/jsonRPC
TON_RPC_API_KEY=
WOTK_JETTON_MASTER_ADDRESS=

# КРИТИЧНО: в проде использовать Docker secrets, systemd LoadCredential или
# secret manager (Vault/AWS SM). См. docs/SECURITY.md §3.
# Никогда не копировать значение в логи / Sentry / документацию.
HOT_WALLET_MNEMONIC=

# === Sentry ===
# Если пустой в non-development environment — startup-warning, но не fatal.
# Errors не будут отчитываться, исправить как можно скорее.
SENTRY_DSN=

# === Geo blocking ===
GEO_BLOCK_COUNTRIES=US,GB,IR,KP,SY,CU

# === Rate limiting (per minute) ===
RATE_LIMIT_PER_USER_PER_MIN=600
RATE_LIMIT_PER_IP_PER_MIN=1200
RATE_LIMIT_LOGIN_PER_IP_PER_MIN=20
