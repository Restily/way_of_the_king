{
  "name": "wotk-realtime",
  "version": "0.1.0",
  "description": "Way Of The King — realtime game rooms (Colyseus)",
  "private": true,
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "start": "node build/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@colyseus/core": "^0.17.43",
    "@colyseus/monitor": "^0.17.8",
    "@colyseus/redis-presence": "^0.17.7",
    "@colyseus/schema": "^3.0.0",
    "@colyseus/ws-transport": "^0.17.13",
    "colyseus": "^0.17.10",
    "express": "^4.21.0",
    "express-basic-auth": "^1.2.1",
    "jsonwebtoken": "^9.0.2",
    "msgpackr": "^1.11.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
